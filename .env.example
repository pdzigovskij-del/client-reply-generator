GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_TEMPERATURE=0.3
GIGACHAT_GUARD_RETRIES=3
PROMPT_VERSION=v6_final

# Необязательно: PEM-бандл с сертификатами НУЦ Минцифры.
# Нужен, если при запросе возникает ошибка CERTIFICATE_VERIFY_FAILED.
GIGACHAT_CA_BUNDLE=.certs/gigachat_ca_bundle.pem

# Отключать проверку SSL можно только временно для локальной проверки.
# GIGACHAT_VERIFY_SSL=true
